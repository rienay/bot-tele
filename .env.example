# Telegram Bot Token dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key dari https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Service Account Credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID Spreadsheet Google Sheets (dari URL spreadsheet)
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEET_NAME=Transaksi

# ID Folder Google Drive untuk menyimpan foto nota
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# (Opsional) URL Web App Google Apps Script jika ingin upload nota via kuota Gmail personal
GOOGLE_DRIVE_GAS_URL=

# Opsional: ID Akun Telegram Anda (agar hanya Anda yang bisa pakai bot ini)
ALLOWED_TELEGRAM_USER_IDS=
